# =============================================================================
# V Learning — Environment Variables
# Copy this file to .env and fill in actual values
# =============================================================================

# UI Base URL
UI_BASE_URL=https://demo2.cybersoft.edu.vn

# API Base URL
API_BASE_URL=https://elearningnew.cybersoft.edu.vn

# CyberSoft Platform Token (required for all API calls)
TOKEN_CYBERSOFT=<your_token_here>

# Test Account Credentials
TEST_USERNAME=
TEST_PASSWORD=

# Group Code (default: GP01)
MA_NHOM=GP01

# =============================================================================
# Jira Integration (Optional - for /fetch_jira_requirements & /e2e_jira_to_automation)
# =============================================================================
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=VL

