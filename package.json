{
  "name": "demo-ai-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript Automation Framework for V Learning E-Learning Platform",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=ui",
    "test:api": "npx playwright test --project=api",
    "test:headed": "npx playwright test --project=ui --headed",
    "report": "npx playwright show-report",
    "report:allure": "allure serve allure-results",
    "generate:allure": "allure generate allure-results --clean -o allure-report",
    "test:allure": "npx playwright test --reporter=line,allure-playwright",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"['test-results','playwright-report','allure-results','allure-report'].forEach(d => require('fs').rmSync(d, {recursive: true, force: true}))\"",
    "bot": "node scripts/telegram_bot.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f telegram-bot",
    "jira:fetch": "node scripts/integrations/jira/jira_fetcher.js"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "axios": "^1.20.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "node-telegram-bot-api": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.12.2",
    "typescript": "^5.7.0"
  }
}
